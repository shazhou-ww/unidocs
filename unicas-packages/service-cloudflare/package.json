{
  "name": "@unicas/service-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Unified UniCAS service deployment for Cloudflare Workers",
  "type": "module",
  "main": "./src/worker.ts",
  "types": "./src/worker.ts",
  "exports": {
    ".": {
      "types": "./src/worker.ts",
      "development": "./src/worker.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @unicas/admin-webui build:ui && tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unicas/admin-webui": "workspace:*",
    "@unicas/control-plane": "workspace:*",
    "@unicas/control-plane-mcp": "workspace:*",
    "@unicas/server-cloudflare": "workspace:*",
    "@unicas/service": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}