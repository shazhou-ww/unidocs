{
  "name": "@unicas/service-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Unified UniCAS service deployment for Cloudflare Workers",
  "type": "module",
  "main": "./src/worker.ts",
  "types": "./src/worker.ts",
  "exports": {
    ".": {
      "types": "./src/worker.ts",
      "development": "./src/worker.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @unicas/admin-webui build:ui && node scripts/build-ui-assets.mjs && tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@unicas/admin-protocol": "workspace:*",
    "@unicas/codec": "workspace:*",
    "@unicas/control-auth": "workspace:*",
    "@unicas/service": "workspace:*",
    "@unicas/tenant-protocol": "workspace:*",
    "agents": "0.21.0",
    "jose": "^6.2.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "jose": "^6.2.10",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
