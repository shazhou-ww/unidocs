{
  "name": "@unicas/control-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Shared server-only OIDC authentication for Unicas control-plane ingress",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
