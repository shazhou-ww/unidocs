{
  "name": "@unicas/server-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical stack-scoped CAS tenant server (Cloudflare Workers)",
  "type": "module",
  "main": "./src/worker.ts",
  "types": "./src/worker.ts",
  "exports": {
    ".": {
      "types": "./src/worker.ts",
      "development": "./src/worker.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unicas/control-plane": "workspace:*",
    "@unicas/tenant-protocol": "workspace:*",
    "@unicas/codec": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0",
    "@unidocs/service-auth": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/worker.js",
    "types": "./dist/worker.d.ts",
    "exports": {
      ".": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js"
      }
    }
  }
}
