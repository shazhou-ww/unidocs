{
  "name": "@unidocs/cloudflare-markdown",
  "version": "0.1.0",
  "description": "Cloudflare deployment adapter for the UniDocs Markdown document type",
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unicas/tenant-client": "workspace:*",
    "@unicas/tenant-blob-client": "workspace:*",
    "@unicas/codec": "workspace:*",
    "@unidocs/service-auth": "workspace:*",
    "@unidocs/protocol": "workspace:*",
    "@unidocs/protocol-platform": "workspace:*",
    "@unidocs/protocol-tenant-portal": "workspace:*",
    "@unidocs/svalue-codec": "workspace:*",
    "@unidocs/cloudflare-sdk": "workspace:*",
    "@unidocs/doctype-server-common": "workspace:*",
    "@unidocs/doctype-markdown": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
