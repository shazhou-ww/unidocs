{
  "name": "@unidocs/cloudflare-markdown",
  "version": "0.1.0",
  "description": "Cloudflare deployment adapter for the UniDocs Markdown document type",
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unidocs/cloudflare-sdk": "workspace:*",
    "@unidocs/doctype-markdown": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
