# Google OAuth client for the admin console's sign-in.
#
# Copy to `.dev.vars` (gitignored; this `.example` is committed) and fill in a
# client from https://console.cloud.google.com/apis/credentials. The local dev
# runtime (`pnpm dev portal`) reads it and injects these as bindings on the
# portal worker.
#
# You do NOT need this to run the portal. Without it the runtime binds
# placeholder credentials and every route behaves normally — `/admin/auth/login`
# still redirects, and Google rejects the placeholder client id when the browser
# arrives. Only *completing* a sign-in needs a real client.
#
# Register this as an authorized redirect URI on that same client:
#
#   http://127.0.0.1:8795/admin/auth/callback
#
# The names below are the worker's binding names, not the environment variables
# of the same purpose. `GOOGLE_OIDC_CLIENT_ID` / `GOOGLE_OIDC_CLIENT_SECRET` in
# the process environment do the same job and override this file — but they are
# read once and handed to the CAS admin BFF as well, so setting them also moves
# the console on :4070 off its local mock provider and onto real Google (which
# then needs a second redirect URI, http://localhost:4070/admin/auth/callback).
# This file reaches only the portal.

GATEWAY_OIDC_CLIENT_ID=
GATEWAY_OIDC_CLIENT_SECRET=

# The Google account that becomes the first administrator. Required to get in
# at all: nobody is an administrator on a fresh database, and sign-in refuses
# every identity until one is designated here (the console shows "no
# permission"). Use the same address you sign in to Google with.
#
# Under `pnpm dev portal` the dev seed (see the end of this file) invites this
# address as an administrator on every boot, so it signs in as an invited
# member and the bootstrap row is never claimed. Changing it adds the new
# address and leaves the old one; to start over, stop the dev server and delete
# `.wrangler/miniflare` at the repository root — that is the local D1 database.
# Without the seed (a bare `startLocalRuntime`), it is consumed once: the first
# successful sign-in claims the bootstrap row, and further administrators are
# added from inside the console.
#
# Also settable as UNIDOCS_PORTAL_BOOTSTRAP_EMAIL in the environment, which
# overrides this line.

PORTAL_BOOTSTRAP_EMAIL=

# Local sign-in shortcut for the tenant console. Off by default: `pnpm dev
# portal` then signs in with real Google (the seed adds PORTAL_BOOTSTRAP_EMAIL
# as a member of t-local). Set to "true" to get a t-local / user-local session
# without signing in; it only works on a loopback PORTAL_ORIGIN. While it is on,
# "sign out" only ends the current session: the console's next session probe
# carries no cookie and is handed a fresh dev session. Turn it off to test real
# sign-in and sign-out.
#
# PORTAL_TENANT_DEV_SESSION=true

# The markdown Operator loop. `pnpm dev portal` starts the markdown worker
# beside the portal and generates both values on every boot, handing the same
# ones to both workers — leave them unset unless something outside the runtime
# has to know them in advance. Set here, or in the environment as
# UNIDOCS_AGENT_API_TOKEN / UNIDOCS_MARKDOWN_OPERATOR_HMAC_KEY (which override
# this file; the unprefixed names in the environment are ignored). The key must
# be 64 lowercase hex characters; anything else stops `pnpm dev portal` at
# startup.
#
# On every boot `pnpm dev portal` also seeds the markdown document type through
# the admin API, as the administrator seed@unidocs.local, and invites
# PORTAL_BOOTSTRAP_EMAIL (above) instead of consuming the bootstrap — so that
# account signs in as an invited administrator.
#
# AGENT_API_TOKEN=
# MARKDOWN_OPERATOR_HMAC_KEY=
