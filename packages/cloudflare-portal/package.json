{
  "name": "@unidocs/cloudflare-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare UniDocs Admin Portal adapter",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:webui": "pnpm --filter '@unidocs/admin-portal-webui^...' --filter '@unidocs/tenant-portal-webui^...' build && pnpm --filter @unidocs/admin-portal-webui build && pnpm --filter @unidocs/tenant-portal-webui build && node scripts/build-ui-assets.mjs",
    "types:generate": "wrangler types src/env.generated.d.ts --include-runtime=false --strict-vars=false",
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:check": "pnpm run build:webui && wrangler deploy --dry-run",
    "build": "pnpm run build:webui && tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@unicas/tenant-blob-client": "workspace:*",
    "@unicas/tenant-client": "workspace:*",
    "@unidocs/portal-service": "workspace:*",
    "@unidocs/protocol": "workspace:*",
    "@unidocs/protocol-admin-portal": "workspace:*",
    "@unidocs/protocol-platform": "workspace:*",
    "@unidocs/protocol-tenant-portal": "workspace:*",
    "@unidocs/service-auth": "workspace:*",
    "agents": "0.21.0",
    "jose": "^6.2.10",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}