{
  "name": "@unidocs/cloudflare-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare UniDocs Admin Portal adapter",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "types:generate": "wrangler types src/env.generated.d.ts --include-runtime=false --strict-vars=false",
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:check": "wrangler deploy --dry-run",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@unidocs/portal-service": "workspace:*",
    "jose": "^6.2.10",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}