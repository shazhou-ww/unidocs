{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unidocs-portal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "unidocs.shazhou.work/admin",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/admin/*",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/mcp",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/.well-known/oauth-protected-resource/mcp",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/.well-known/oauth-authorization-server",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/oauth/admin-mcp/*",
      "zone_name": "shazhou.work"
    },
    // Do not deploy these three routes before the tenant data plane is
    // configured: AGENT_API_TOKEN and the CAS_* vars/secret below are not
    // set in this file, and the D1 migrations for portal_tenant_members etc.
    // must be applied first. Deploying routes ahead of that lets a user sign
    // in and create a document, but the Operator submission is refused 401
    // and every snapshot read comes back unavailable. Follow the ordered
    // go-live steps under "Tenant console go-live in production" in
    // docs/deployment-and-local-configuration.md.
    {
      "pattern": "unidocs.shazhou.work/portal",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/portal/*",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "unidocs.shazhou.work/api/v1/tenants/*",
      "zone_name": "shazhou.work"
    },
    {
      "pattern": "bundles.shazhou.work",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "GATEWAY_OIDC_CLIENT_SECRET",
      "OAUTH_STATE_ENCRYPTION_KEY",
      "MARKDOWN_OPERATOR_HMAC_KEY"
    ]
  },
  "vars": {
    "MCP_ENABLED": "true",
    "MCP_PUBLIC_ORIGIN": "https://unidocs.shazhou.work",
    "MCP_ADMIN_EMAIL_ALLOWLIST": "shazhou.ww@gmail.com,neko.shazhou.ww@gmail.com",
    "MCP_CONTENT_MUTATIONS_ENABLED": "true",
    "MCP_PUBLISH_MUTATIONS_ENABLED": "true",
    "MCP_SECURITY_MUTATIONS_ENABLED": "true",
    "PORTAL_ORIGIN": "https://unidocs.shazhou.work",
    "BUNDLE_ORIGIN": "https://bundles.shazhou.work",
    "GATEWAY_OIDC_ISSUER": "https://accounts.google.com",
    "GATEWAY_OIDC_CLIENT_ID": "1092012735121-ukf9g56u8m7bpk20vqurlqj3q58on885.apps.googleusercontent.com",
    "PORTAL_BOOTSTRAP_EMAIL": "shazhou.ww@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unidocs-portal",
      "database_id": "b03c6e6b-e4b7-49a8-b3f1-6ab8e5baeae1",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "dc729749e0ad46de981e99d10d29ffd1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "unidocs-portal-bundles"
    }
  ],
  "services": [
    {
      "binding": "ADMIN_MARKDOWN_SERVICE",
      "service": "unidocs-markdown"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}