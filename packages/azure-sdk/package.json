{
  "name": "@unidocs/azure-sdk",
  "version": "0.1.0",
  "description": "Azure-backed storage adapters for UniDocs (Postgres + Blob Storage)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle-migrate-cli.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@unidocs/cas-client": "workspace:*",
    "@unidocs/svalue-codec": "workspace:*",
    "@unidocs/http-protocol": "workspace:*",
    "@unidocs/protocol": "workspace:*",
    "@unidocs/doctype-server-common": "workspace:*",
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@unidocs/doctype-markdown": "workspace:*",
    "@types/pg": "^8.23.1",
    "azurite": "3.36.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
