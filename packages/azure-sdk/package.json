{
  "name": "@unidocs/azure-sdk",
  "version": "0.1.0",
  "description": "Azure-backed storage adapters for UniDocs (Postgres + Blob Storage)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "migrate": "node scripts/bundle-migrate-cli.mjs && node dist/migrate-cli.js"
  },
  "dependencies": {
    "@unidocs/server-core": "workspace:*",
    "pg": "^8.23.0",
    "@azure/storage-blob": "^12.33.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
