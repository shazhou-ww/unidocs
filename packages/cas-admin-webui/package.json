{
  "name": "@unidocs/cas-admin-webui",
  "version": "0.1.0",
  "private": true,
  "description": "CAS stack administration WebUI and OIDC BFF",
  "type": "module",
  "main": "./src/server/index.ts",
  "types": "./src/server/index.ts",
  "exports": {
    ".": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unidocs/cas-control-plane": "workspace:*",
    "@unidocs/protocol-cas-admin": "workspace:*",
    "jose": "^6.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
