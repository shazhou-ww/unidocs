{
  "name": "@unidocs/core",
  "version": "0.1.0",
  "description": "Cloud-neutral document type contracts for UniDocs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "import": "./src/internal.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "cborg": "^6.1.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      }
    }
  }
}
