{
  "name": "@unidocs/doctype-psd",
  "version": "0.1.0",
  "description": "Cloud-neutral PSD image document type for UniDocs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "import": "./src/engine.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@unidocs/doctype-server-common": "workspace:*",
    "@unidocs/protocol": "workspace:*",
    "ag-psd": "^31.0.0",
    "fast-png": "^8.0.0"
  },
  "devDependencies": {
    "@unidocs/http-protocol": "workspace:*",
    "@unidocs/server-core": "workspace:*",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./engine": {
        "types": "./dist/engine.d.ts",
        "import": "./dist/engine.js"
      }
    }
  }
}
