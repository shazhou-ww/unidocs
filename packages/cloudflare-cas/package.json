{
  "name": "@unidocs/cloudflare-cas",
  "version": "0.1.0",
  "description": "User-scoped CAS worker for UniDocs",
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./public": {
      "types": "./dist/public-cas-route.d.ts",
      "import": "./dist/public-cas-route.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unidocs/cas": "workspace:*",
    "@unidocs/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}