{
  "name": "@unidocs/psd-client",
  "version": "0.1.0",
  "description": "Browser-side PSD render client for UniDocs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@unicas/codec": "workspace:*",
    "@unidocs/doctype-psd": "workspace:*",
    "@unidocs/svalue-codec": "workspace:*",
    "@unidocs/protocol": "workspace:*"
  },
  "devDependencies": {
    "fast-png": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}