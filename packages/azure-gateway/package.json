{
  "name": "@unidocs/azure-gateway",
  "version": "0.1.0",
  "description": "Azure/Node entry point for the UniDocs API Gateway",
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "node scripts/build-web-assets.mjs && tsc && node scripts/bundle.mjs",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate-cli.js",
    "test": "node scripts/build-web-assets.mjs && vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" src/web-assets.generated.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@unidocs/azure-sdk": "workspace:*",
    "@unidocs/gateway-common": "workspace:*",
    "@unidocs/gateway-oauth": "workspace:*",
    "@unidocs/protocol-gateway": "workspace:*",
    "@unidocs/service-auth": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      }
    }
  }
}