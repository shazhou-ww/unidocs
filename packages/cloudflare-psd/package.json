{
  "name": "@unidocs/cloudflare-psd",
  "version": "0.1.0",
  "description": "Cloudflare deployment adapter for the UniDocs PSD document type",
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./agent-deps": {
      "types": "./src/agent-deps.ts",
      "import": "./src/agent-deps.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unidocs/cloudflare-sdk": "workspace:*",
    "@unidocs/doctype-server-common": "workspace:*",
    "@unidocs/doctype-psd": "workspace:*",
    "@unidocs/protocol-doc": "workspace:*",
    "@unidocs/service-auth": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "jose": "^6.2.10",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
