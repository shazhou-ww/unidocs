# Copy to .dev.vars and fill in your Anthropic key to enable the PSD Operator
# (the chatbox agent). .dev.vars is gitignored; this .example is committed.
#
# The local dev runtime (pnpm dev unidocs-cloudflare psd) reads .dev.vars and injects these as
# bindings on the psd worker.

LLM_API_KEY=sk-ant-...
# Optional — defaults shown:
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-sonnet-latest

# 图像编辑模型（editPixels）。不配就没有 editPixels 工具，层内像素编辑不可用。
# DashScope 控制台拿 key：https://bailian.console.aliyun.com/
IMAGE_EDIT_API_KEY=sk-...
# Optional — defaults shown:
# IMAGE_EDIT_MODEL=qwen-image-edit-plus
# IMAGE_EDIT_BASE_URL=https://dashscope.aliyuncs.com

# setText 的字体回退链,逗号分隔,顺序即优先级。名字必须是索引里真有的
# postScriptName(内置那一档 + 租户登记的那一档)—— 写一个不存在的名字不会
# 报错,只会让回退链静默失效。
#
# **不设 = 内置字体那两套**(@unidocs/fonts-builtin 的 BUILTIN_FALLBACKS:
# 拉丁全量 + 中文 8105 字,随包发行)。所以这一段基本不用管,包括本地开发。
# **显式设成空串是逃生口**,意思是"一个候选都不试" —— 那会让中文层整层画不
# 出来,别拿它当"默认值"。
#
# `pnpm dev` 起来时还会把 Noto Sans / Noto Sans SC / Josefin Sans Bold 的
# **全量版**灌进租户 u1 的字体索引(有就跳过,没有就下载再灌)。它不再改这个
# 变量:前两套用的是和内置那两套一样的名字,租户那一档按 postScriptName 盖掉
# 内置那一档,同一条默认回退链自动指向全量版。见 scripts/psd-font-bootstrap.mjs
# 与 docs/psd-text-layers.md §5.4;不想要就 `pnpm dev … --fonts off`。
#
# 只有想改优先级、或者装了别的名字的字体时才写这里,而且**这里是唯一的口子**:
# runtime.mjs 的 mergeDocBindings 里排在 .dev.vars 之后的那一档只透传
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 三个键,所以 shell 里设 PSD_FONT_FALLBACKS
# 在 Cloudflare 本地栈上不生效。
# 下面这两个值与 scripts/psd-fonts.example.json 里的 postScriptName 一致,是真实
# 字体解析出来的名字(带 -Regular 后缀)。别按家族名写成 NotoSans —— 那正是上面
# 说的"不会报错、只是静默失效"。跑完预置脚本可以照它打印的名字抄。
# PSD_FONT_FALLBACKS=NotoSans-Regular,NotoSansSC-Regular
