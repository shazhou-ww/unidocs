{
  "name": "@unidocs/cas-control-plane",
  "version": "0.1.0",
  "description": "Cloud-neutral CAS stack control-plane service library",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@unidocs/protocol-cas-admin": "workspace:*",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
