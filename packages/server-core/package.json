{
  "name": "@unidocs/server-core",
  "version": "0.1.0",
  "description": "Cloud-neutral document session core for UniDocs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./port-contract": {
      "types": "./src/testing/port-contract.ts",
      "import": "./src/testing/port-contract.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@unidocs/core": "workspace:*",
    "@unidocs/cas": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./port-contract": {
        "types": "./dist/testing/port-contract.d.ts",
        "import": "./dist/testing/port-contract.js"
      }
    }
  }
}
