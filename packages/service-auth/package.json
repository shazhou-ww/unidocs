{
  "name": "@unidocs/service-auth",
  "version": "0.1.0",
  "description": "Cloud-neutral internal capability issuance and verification for UniDocs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@unidocs/protocol-doctype": "workspace:*",
    "jose": "^6.2.10",
    "@unicas/tenant-protocol": "workspace:*"
  }
}
