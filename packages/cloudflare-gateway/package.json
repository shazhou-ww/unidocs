{
  "name": "@unidocs/cloudflare-gateway",
  "version": "0.1.0",
  "description": "Cloudflare API Gateway for UniDocs document type workers",
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @unidocs/web-gateway build && node scripts/build-ui-assets.mjs && tsc -b",
    "build:worker": "tsc -b",
    "test": "node scripts/build-ui-assets.mjs && vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" src/ui-assets.generated.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unicas/control-auth": "workspace:*",
    "@unidocs/gateway-common": "workspace:*",
    "@unidocs/gateway-oauth": "workspace:*",
    "@unidocs/protocol-gateway": "workspace:*",
    "@unidocs/service-auth": "workspace:*",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}