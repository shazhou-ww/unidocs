{
  "name": "@unidocs/cloudflare-gateway",
  "version": "0.1.0",
  "description": "Cloudflare API Gateway for UniDocs document type workers",
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@unidocs/gateway-common": "workspace:*",
    "@unidocs/protocol-gateway": "workspace:*",
    "@unidocs/service-auth": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250817.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
