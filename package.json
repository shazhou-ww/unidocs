{
  "name": "unidocs",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-stack.mjs dev",
    "dev:cf": "node scripts/run-stack.mjs dev unidocs-cloudflare",
    "dev:azure": "node scripts/run-stack.mjs dev unidocs-azure",
    "dev:unicas": "node scripts/run-stack.mjs dev unicas",
    "deploy": "node scripts/run-stack.mjs deploy",
    "smoke": "node scripts/run-stack.mjs smoke",
    "build": "pnpm -r build",
    "check:cas-contract-docs": "node scripts/check-cas-contract-docs.mjs",
    "test": "pnpm check:cas-contract-docs && pnpm -r test",
    "test:local": "pnpm check:cas-contract-docs && vitest run --fileParallelism=false tests/unit tests/integration/cloudflare tests/integration/shared",
    "test:azure": "vitest run --fileParallelism=false tests/integration/azure",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r run clean",
    "keys:local": "node scripts/generate-local-capability-keys.mjs",
    "azure:up": "docker compose -f packages/azure-sdk/docker-compose.yml up -d",
    "azure:down": "docker compose -f packages/azure-sdk/docker-compose.yml down"
  },
  "devDependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@types/node": "^24.0.0",
    "azurite": "3.36.0",
    "esbuild": "^0.28.2",
    "jose": "^6.2.10",
    "miniflare": "5.20260811.1-alpha",
    "pg": "^8.23.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0"
}